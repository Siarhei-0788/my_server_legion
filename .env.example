POSTGRES_DB=legion
POSTGRES_USER=legion
POSTGRES_PASSWORD=replace-with-a-long-random-password

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_FILE=./secrets/firebase-service-account.json
REGISTRATION_CODE_SECRET=replace-with-at-least-32-random-characters

TURN_REALM=turn.example.com
TURN_EXTERNAL_IP=203.0.113.10/172.30.0.10
TURN_SHARED_SECRET=replace-with-a-different-long-random-secret
TURN_CERT_FILE=./secrets/fullchain.pem
TURN_KEY_FILE=./secrets/privkey.pem
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
TURN_CREDENTIAL_TTL_SECONDS=3600

# Comma-separated browser origins. Native Android clients do not send Origin.
CORS_ORIGINS=https://app.example.com
RTC_CALL_TIMEOUT_MS=60000

# Set only when the service runs behind a reverse proxy (nginx/Caddy/Traefik),
# otherwise every client shares one rate-limit bucket. Example: TRUST_PROXY=1
TRUST_PROXY=

# Сообщения старше этого числа дней удаляются раз в час. 0 — хранить бессрочно.
MESSAGE_RETENTION_DAYS=30
