# Переменные демонстрационного сервера (server-dev.js).
# Скопируйте в /etc/legion.env на сервере или используйте локально.

PORT=3000

# Куда сохранять состояние (пользователи, токены, устройства, сообщения).
# Файл переживает перезапуск. STATE_FILE=off отключает сохранение.
STATE_FILE=./data/state.json

# Администратор создаётся при первом запуске.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=замените-на-длинный-пароль

# STUN обязателен, TURN — для звонков через мобильные сети/NAT.
STUN_URLS=stun:stun.l.google.com:19302
# TURN_URLS=turn:legion.example.com:3478?transport=udp,turns:legion.example.com:5349?transport=tcp
# TURN_SHARED_SECRET=секрет-из-turnserver.conf
# TURN_CREDENTIAL_TTL_SECONDS=3600

# Лимит попыток входа с одного IP в минуту.
AUTH_RATE_LIMIT=30

# Таймаут входящего звонка, мс.
RTC_CALL_TIMEOUT_MS=60000
